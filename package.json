{
  "name": "hair",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @hair/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "pnpm -r lint",
    "check:safety": "node scripts/check-repository-safety.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
